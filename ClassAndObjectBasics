public class ClassAndObjectBasics {

public static void main(String[] args) {
// Creating objects from a class
Student s1 = new Student("Chelsia", 22);
Student s2 = new Student("Sam", 20);

s1.printDetails();
s2.printDetails();

// using a setter to update a field
s1.setAge(23);
System.out.println("\nAfter birthday:");
s1.printDetails();
}
}

class Student {
// private fields (encapsulation)
private String name;
private int age;

// constructor
public Student(String name, int age) {
this.name = name;
this.age = age;
}

// getters
public String getName() {
return name;
}

public int getAge() {
return age;
}

// setters
public void setName(String name) {
this.name = name;
}

public void setAge(int age) {
this.age = age;
}

// regular method
public void printDetails() {
System.out.println("Name: " + name + ", Age: " + age);
}
}
