import java.util.Scanner;

public class RoadAccidentReport {

public static void main(String[] args) {
Scanner scanner = new Scanner(System.in);

// Step 1: Set up the data
String[] cities = {"Cape Town", "Johannesburg", "Port Elizabeth"};
int[][] accidents = new int[3][2]; // [city][0=car, 1=bike]

// Step 2: Get input from the user
for (int i = 0; i < cities.length; i++) {
System.out.print("Enter the number of car accidents for " + cities[i] + ": ");
accidents[i][0] = scanner.nextInt();

System.out.print("Enter the number of motor bike accidents for " + cities[i] + ": ");
accidents[i][1] = scanner.nextInt();
}

// Step 3: Print the report table
System.out.println("\nROAD ACCIDENT REPORT");
System.out.println("\t\tCAR\tMOTOR BIKE");
for (int i = 0; i < cities.length; i++) {
System.out.println(cities[i] + "\t" + accidents[i][0] + "\t" + accidents[i][1]);
}

// Step 4: Totals per city + find the highest
int highest = 0;
String highestCity = "";

System.out.println("\nROAD ACCIDENT TOTALS FOR EACH CITY");
for (int i = 0; i < cities.length; i++) {
int cityTotal = accidents[i][0] + accidents[i][1];
System.out.println(cities[i] + "\t" + cityTotal);

if (cityTotal > highest) {
highest = cityTotal;
highestCity = cities[i];
}
}

System.out.println("\nCITY WITH THE MOST VEHICLE ACCIDENTS: " + highestCity);

scanner.close();
}
}
