public class ProductSales implements IProductSales {

@Override
public int TotalSales(int[][] productSales) {

int total = 0;

for (int i = 0; i < productSales.length; i++) {

for (int j = 0; j < productSales[i].length; j++) {

total = total + productSales[i][j];
}
}

return total;
}

@Override
public double AverageSales(int[][] productSales) {

int total = TotalSales(productSales);

int count = 0;

for (int i = 0; i < productSales.length; i++) {
count = count + productSales[i].length;
}

double average = (double) total / count;

return average;
}

@Override
public int MaxSale(int[][] productSales) {

int highest = productSales[0][0];

for (int i = 0; i < productSales.length; i++) {

for (int j = 0; j < productSales[i].length; j++) {

if (productSales[i][j] > highest) {

highest = productSales[i][j];
}
}
}

return highest;
}

@Override
public int MinSale(int[][] productSales) {

int lowest = productSales[0][0];

for (int i = 0; i < productSales.length; i++) {

for (int j = 0; j < productSales[i].length; j++) {

if (productSales[i][j] < lowest) {

lowest = productSales[i][j];
}
}
}

return lowest;
}
}
}
