import java.util.ArrayList;
import java.util.Arrays;

public class Arrays {

public static void main(String[] args) {
arrayBasics();
loopThroughArray();
arrayListBasics();
}

public static void arrayBasics() {
System.out.println("--- Array Basics ---");
int[] numbers = {10, 20, 30, 40, 50};

System.out.println("Length: " + numbers.length);
System.out.println("First element: " + numbers[0]);
System.out.println("Last element: " + numbers[numbers.length - 1]);

numbers[2] = 99; // update an element
System.out.println("After update: " + Arrays.toString(numbers));
}

public static void loopThroughArray() {
System.out.println("\n--- Looping Through Array ---");
String[] names = {"Alice", "Bob", "Charlie"};

// standard for loop
for (int i = 0; i < names.length; i++) {
System.out.println(i + ": " + names[i]);
}

// enhanced for-each loop
System.out.println("Using for-each:");
for (String name : names) {
System.out.println(name);
}
}

public static void arrayListBasics() {
System.out.println("\n--- ArrayList Basics ---");
ArrayList<String> list = new ArrayList<>();
list.add("Java");
list.add("Python");
list.add("C#");

list.remove("Python"); // remove by value
list.add(1, "Kotlin"); // insert at index

System.out.println("List: " + list);
System.out.println("Contains Java? " + list.contains("Java"));
System.out.println("Size: " + list.size());
}
}
