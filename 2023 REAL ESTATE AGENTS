package estateagent;

// Q.1.4 contract exactly as given in the paper
public interface IEstateAgent {
    double EstateAgentSales(double[] propertySales);
    double EstateAgentCommission(double propertySales);
    int TopEstateAgent(double[] totalSales);
}
//EstateAgent.java
package estateagent;

public class EstateAgent implements IEstateAgent {

    private static final double COMMISSION_RATE = 0.02; // 2% commission

    // Q.1.2 total sales for one agent (one row of the 2D array)
    @Override
    public double EstateAgentSales(double[] propertySales) {
        double total = 0;
        for (double sale : propertySales) {
            total += sale;
        }
        return total;
    }

    // Q.1.3 commission is 2% of the total sales
    @Override
    public double EstateAgentCommission(double propertySales) {
        return propertySales * COMMISSION_RATE;
    }

    // Returns the INDEX of the agent with the highest total
    @Override
    public int TopEstateAgent(double[] totalSales) {
        int topIndex = 0;
        for (int i = 1; i < totalSales.length; i++) {
            if (totalSales[i] > totalSales[topIndex]) {
                topIndex = i;
            }
        }
        return topIndex;
    }
}
//Main.java
package estateagent;

import java.util.Locale;

public class Main {
    public static void main(String[] args) {
        String[] agents = {"Joe Bloggs", "Jane Doe"};
        String[] months = {"JAN", "FEB", "MAR"};

        // Q.1.1 two dimensional array: row = agent, column = month
        double[][] sales = {
            {800000, 1500000, 2000000},
            {700000, 1200000, 1600000}
        };

        IEstateAgent agent = new EstateAgent();
        double[] totals = new double[agents.length];
        double[] commissions = new double[agents.length];

        System.out.println("ESTATE AGENTS SALES REPORT\n");
        System.out.printf("%-20s", "");
        for (String month : months) {
            System.out.printf("%-20s", month);
        }
        System.out.println("\n" + "-".repeat(80));

        // Print monthly sales and calculate totals and commission
        for (int row = 0; row < agents.length; row++) {
            System.out.printf("%-20s", agents[row]);
            for (int col = 0; col < months.length; col++) {
                System.out.printf("%-20s", "R " + sales[row][col]);
            }
            System.out.println();

            totals[row] = agent.EstateAgentSales(sales[row]);
            commissions[row] = agent.EstateAgentCommission(totals[row]);
        }

        // Q.1.2 total property sales
        System.out.println();
        for (int i = 0; i < agents.length; i++) {
            System.out.println("Total property sales for " + agents[i] + " = R "
                    + String.format(Locale.US, "%,.0f", totals[i]));
        }

        // Q.1.3 commission
        System.out.println();
        for (int i = 0; i < agents.length; i++) {
            System.out.println("Sales Commission for " + agents[i] + " = R "
                    + String.format(Locale.US, "%,.0f", commissions[i]));
        }

        // Top performer
        System.out.println("\nTop performing estate agent: "
                + agents[agent.TopEstateAgent(totals)]);
    }
}
