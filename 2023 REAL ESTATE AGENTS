// Q.2.7 contract exactly as given in the paper
public interface IEstateAgent {
    double CalculateCommission(String propertyPrice, String agentCommission);
    boolean ValidateData(Data dataToValidate);
}
// Data.java
package estateagent;

public class Data {
    private final String agentLocation;
    private final String agentName;
    private final double propertyPrice;
    private final double commissionPercentage;

    public Data(String agentLocation, String agentName,
                double propertyPrice, double commissionPercentage) {
        this.agentLocation = agentLocation;
        this.agentName = agentName;
        this.propertyPrice = propertyPrice;
        this.commissionPercentage = commissionPercentage;
    }

    public String getAgentLocation() { return agentLocation; }
    public String getAgentName() { return agentName; }
    public double getPropertyPrice() { return propertyPrice; }
    public double getCommissionPercentage() { return commissionPercentage; }
}
//EstateAgent.java
package estateagent;

public class EstateAgent implements IEstateAgent {

    // Q.2.4 commission = price x (percentage / 100). 800000 x 10% = 80000.0
    @Override
    public double CalculateCommission(String propertyPrice, String agentCommission) {
        double price = Double.parseDouble(propertyPrice);
        double percentage = Double.parseDouble(agentCommission);
        return price * (percentage / 100);
    }

    // Q.2.7 validation rules
    @Override
    public boolean ValidateData(Data data) {
        if (data.getAgentLocation() == null || data.getAgentLocation().trim().isEmpty()) {
            return false;   // location cannot be empty
        }
        if (data.getAgentName() == null || data.getAgentName().trim().isEmpty()) {
            return false;   // name cannot be empty
        }
        if (data.getPropertyPrice() <= 0) {
            return false;   // price must be above zero
        }
        return data.getCommissionPercentage() > 0; // percentage must be above zero
    }
}
