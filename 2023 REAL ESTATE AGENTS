package estateagent;

import javax.swing.*;
import java.awt.*;
import java.io.FileWriter;
import java.io.IOException;
import java.io.PrintWriter;

public class EstateAgentGUI extends JFrame {

    // Q.2.1 one combo box, three text fields, one text area
    private final JComboBox<String> cmbLocation =
            new JComboBox<>(new String[]{"Cape Town", "Durban", "Pretoria"});
    private final JTextField txtName = new JTextField(12);
    private final JTextField txtPrice = new JTextField(12);
    private final JTextField txtCommission = new JTextField(12);
    private final JTextArea txtReport = new JTextArea(6, 25);

    private final IEstateAgent logic = new EstateAgent();

    public EstateAgentGUI() {
        setTitle("Estate Agent Report");
        setDefaultCloseOperation(EXIT_ON_CLOSE);
        setLayout(new GridLayout(0, 2, 5, 10));

        txtReport.setEditable(false);

        add(new JLabel("AGENT LOCATION:"));        add(cmbLocation);
        add(new JLabel("ESTATE AGENT NAME:"));     add(txtName);
        add(new JLabel("PROPERTY PRICE:"));        add(txtPrice);
        add(new JLabel("COMMISSION PERCENTAGE:")); add(txtCommission);
        add(new JLabel("ESTATE AGENT REPORT:"));   add(new JLabel());
        add(new JScrollPane(txtReport));

        setJMenuBar(buildMenu());
        pack();
        setLocationRelativeTo(null);
    }

    // Q.2.2 menu: File > Exit ; Tools > Process Report, Clear, Save Report
    private JMenuBar buildMenu() {
        JMenuBar bar = new JMenuBar();

        JMenu file = new JMenu("File");
        JMenuItem exit = new JMenuItem("Exit");
        exit.addActionListener(e -> System.exit(0));        // Q.2.3
        file.add(exit);

        JMenu tools = new JMenu("Tools");
        JMenuItem process = new JMenuItem("Process Report");
        JMenuItem clear = new JMenuItem("Clear");
        JMenuItem save = new JMenuItem("Save Report");
        process.addActionListener(e -> processReport());    // Q.2.4
        clear.addActionListener(e -> clearForm());          // Q.2.6
        save.addActionListener(e -> saveReport());          // Q.2.5
        tools.add(process);
        tools.add(clear);
        tools.add(save);

        bar.add(file);
        bar.add(tools);
        return bar;
    }

    // Q.2.4 capture, validate, calculate and display
    private void processReport() {
        try {
            String location = (String) cmbLocation.getSelectedItem();
            String name = txtName.getText().trim();
            double price = Double.parseDouble(txtPrice.getText().trim());
            double percentage = Double.parseDouble(txtCommission.getText().trim());

            if (!logic.ValidateData(new Data(location, name, price, percentage))) {
                JOptionPane.showMessageDialog(this,
                        "Invalid data. Name cannot be empty; price and percentage must be above 0.");
                return;
            }

            double commission = logic.CalculateCommission(
                    txtPrice.getText().trim(), txtCommission.getText().trim());

            txtReport.setText("AGENT LOCATION: " + location + "\n"
                    + "AGENT NAME: " + name + "\n"
                    + "PROPERTY PRICE: R " + price + "\n"
                    + "COMMISSION PERCENTAGE: " + percentage + "%\n"
                    + "CALCULATED COMMISSION: R " + commission);

        } catch (NumberFormatException ex) {
            JOptionPane.showMessageDialog(this, "Property price and commission must be numbers.");
        }
    }

    // Q.2.5 save the displayed report to report.txt
    private void saveReport() {
        if (txtReport.getText().isEmpty()) {
            JOptionPane.showMessageDialog(this, "Process a report before saving.");
            return;
        }
        String stars = "*".repeat(36);
        try (PrintWriter out = new PrintWriter(new FileWriter("report.txt"))) {
            out.println("ESTATE AGENT REPORT");
            out.println(stars);
            out.println(txtReport.getText());
            out.println(stars);
            JOptionPane.showMessageDialog(this, "Report saved to report.txt");
        } catch (IOException ex) {
            JOptionPane.showMessageDialog(this, "Could not save file: " + ex.getMessage());
        }
    }

    // Q.2.6 back to the default state
    private void clearForm() {
        cmbLocation.setSelectedIndex(0);
        txtName.setText("");
        txtPrice.setText("");
        txtCommission.setText("");
        txtReport.setText("");
    }

    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> new EstateAgentGUI().setVisible(true));
    }
}

