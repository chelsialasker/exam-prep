//Hospital inspections.java
import javax.swing.*;
import java.awt.*;

public class HospitalInspections extends JFrame {

    // Q.1.1 arrays to hold up to five inspections
    private static final int MAX = 5;
    private final String[] names = new String[MAX];
    private final String[] locations = new String[MAX];
    private final String[] years = new String[MAX];
    private int count = 0; // number of inspections saved so far

    // Q.1.1 form controls
    private final JTextField txtName = new JTextField(15);
    private final JTextField txtLocation = new JTextField(15);
    private final JComboBox<String> cmbYears =
            new JComboBox<>(new String[]{"1 Year", "2 Years", "3 Years", "4 Years", "5 Years"});
    private final DefaultListModel<String> listModel = new DefaultListModel<>();
    private final JList<String> lstOutput = new JList<>(listModel);

    public HospitalInspections() {
        setTitle("Hospital Inspections");
        setDefaultCloseOperation(EXIT_ON_CLOSE);
        setLayout(new GridLayout(0, 2, 5, 8));

        JButton btnSave = new JButton("SAVE");
        JButton btnPrint = new JButton("PRINT");
        JButton btnClear = new JButton("CLEAR");
        btnSave.addActionListener(e -> saveInspection());
        btnPrint.addActionListener(e -> printInspections());
        btnClear.addActionListener(e -> clearControls());

        add(new JLabel("Hospital Name:"));          add(txtName);
        add(new JLabel("Hospital Location:"));      add(txtLocation);
        add(new JLabel("Years since inspection:")); add(cmbYears);
        add(new JLabel());                          add(btnSave);
        add(new JScrollPane(lstOutput));            add(new JLabel());
        add(btnPrint);                              add(btnClear);

        // Q.1.2 menu: File > Exit ; Tools > Save, Print, Clear (same methods as the buttons)
        JMenuBar bar = new JMenuBar();
        JMenu file = new JMenu("File");
        JMenuItem exit = new JMenuItem("Exit");
        exit.addActionListener(e -> System.exit(0));
        file.add(exit);

        JMenu tools = new JMenu("Tools");
        JMenuItem mSave = new JMenuItem("Save");
        JMenuItem mPrint = new JMenuItem("Print");
        JMenuItem mClear = new JMenuItem("Clear");
        mSave.addActionListener(e -> saveInspection());
        mPrint.addActionListener(e -> printInspections());
        mClear.addActionListener(e -> clearControls());
        tools.add(mSave); tools.add(mPrint); tools.add(mClear);

        bar.add(file); bar.add(tools);
        setJMenuBar(bar);

        setSize(420, 450);
        setLocationRelativeTo(null);
    }

    // Q.1.1 save to the arrays; Q.1.2 error message on the sixth save
    private void saveInspection() {
        if (count >= MAX) {
            JOptionPane.showMessageDialog(this, "Maximum inspection count reached!");
            return;
        }
        names[count] = txtName.getText();
        locations[count] = txtLocation.getText();
        years[count] = (String) cmbYears.getSelectedItem();
        count++;
        txtName.setText("");
        txtLocation.setText("");
    }

    // Q.1.1 print the array contents to the list box
    private void printInspections() {
        listModel.clear();
        for (int i = 0; i < count; i++) {
            listModel.addElement("Hospital Name: " + names[i]);
            listModel.addElement("Hospital Location: " + locations[i]);
            listModel.addElement("Years Since Inspection: " + years[i]);
            listModel.addElement("*".repeat(32));
        }
    }

    // Q.1.1 clear the controls
    private void clearControls() {
        txtName.setText("");
        txtLocation.setText("");
        cmbYears.setSelectedIndex(0);
        listModel.clear();
    }

    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> new HospitalInspections().setVisible(true));
    }
}
