package movietickets;

public class Main {
    public static void main(String[] args) {
        // Q.1.1 single arrays: movie names and month headings
        String[] movies = {"Napoleon", "Oppenheimer"};
        String[] months = {"JAN", "FEB", "MAR"};

        // Q.1.1 two dimensional array: row = movie, column = month
        int[][] sales = {
            {3000, 1500, 1700},
            {3500, 1200, 1600}
        };

        IMovieTickets tickets = new MovieTickets();
        int[] totals = new int[movies.length];

        // Report heading and column headings
        System.out.println("MOVIE TICKET SALES REPORT - 2024\n");
        System.out.printf("%-20s", "");
        for (String month : months) {
            System.out.printf("%-12s", month);
        }
        System.out.println("\n" + "-".repeat(56));

        // Print rows and columns, and calculate each movie's total
        for (int row = 0; row < movies.length; row++) {
            System.out.printf("%-20s", movies[row]);
            for (int col = 0; col < months.length; col++) {
                System.out.printf("%-12d", sales[row][col]);
            }
            System.out.println();
            totals[row] = tickets.TotalMovieSales(sales[row]);
        }

        // Total sales for each movie
        System.out.println();
        for (int i = 0; i < movies.length; i++) {
            System.out.println("Total movie ticket sales for " + movies[i] + " " + totals[i]);
        }

        // Top performing movie
        System.out.println("\nTop performing movie: " + tickets.TopMovie(movies, totals));
    }
}

