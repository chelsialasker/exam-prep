package movietickets;

// Holds the captured values so they can be validated together
public class MovieTicketData {
    private final String movieName;
    private final int numberOfTickets;
    private final double ticketPrice;

    public MovieTicketData(String movieName, int numberOfTickets, double ticketPrice) {
        this.movieName = movieName;
        this.numberOfTickets = numberOfTickets;
        this.ticketPrice = ticketPrice;
    }

    public String getMovieName() { return movieName; }
    public int getNumberOfTickets() { return numberOfTickets; }
    public double getTicketPrice() { return ticketPrice; }
}

//MovieTickets.java
package movietickets;

public class MovieTickets implements IMovieTickets {

    private static final double VAT_RATE = 0.14; // 14% VAT

    // Q.2.4 total includes VAT: 3 x 100 x 1.14 = 342.0
    @Override
    public double CalculateTotalTicketPrice(int numberOfTickets, double ticketPrice) {
        double subtotal = numberOfTickets * ticketPrice;
        return subtotal + (subtotal * VAT_RATE);
    }

    // Q.2.7 validation rules
    @Override
    public boolean ValidateData(MovieTicketData data) {
        if (data.getMovieName() == null || data.getMovieName().trim().isEmpty()) {
            return false;            // movie name cannot be empty
        }
        if (data.getTicketPrice() <= 0) {
            return false;            // price must be above zero
        }
        return data.getNumberOfTickets() > 0; // tickets must be above zero
    }
}

