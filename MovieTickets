package movietickets;

import javax.swing.*;
import java.awt.*;
import java.io.FileWriter;
import java.io.IOException;
import java.io.PrintWriter;

public class MovieTicketsGUI extends JFrame {

    // Q.2.1 one combo box, two text fields, one read only text area
    private final JComboBox<String> cmbMovie =
            new JComboBox<>(new String[]{"Napoleon", "Oppenheimer", "Damsel"});
    private final JTextField txtTickets = new JTextField(10);
    private final JTextField txtPrice = new JTextField(10);
    private final JTextArea txtReport = new JTextArea(6, 25);

    private final IMovieTickets logic = new MovieTickets();

    public MovieTicketsGUI() {
        setTitle("MOVIE TICKETS");
        setDefaultCloseOperation(EXIT_ON_CLOSE);
        setLayout(new GridLayout(0, 2, 5, 10));

        txtReport.setEditable(false); // Q.2.1 read only

        add(new JLabel("MOVIE:"));             add(cmbMovie);
        add(new JLabel("NUMBER OF TICKETS:")); add(txtTickets);
        add(new JLabel("TICKET PRICE:"));      add(txtPrice);
        add(new JLabel("TICKET REPORT:"));     add(new JLabel());
        add(new JScrollPane(txtReport));

        setJMenuBar(buildMenu());
        pack();
        setLocationRelativeTo(null);
    }

    // Q.2.2 menu: File > Exit ; Tools > Process, Clear
    private JMenuBar buildMenu() {
        JMenuBar bar = new JMenuBar();

        JMenu file = new JMenu("File");
        JMenuItem exit = new JMenuItem("Exit");
        exit.addActionListener(e -> System.exit(0));      // Q.2.3
        file.add(exit);

        JMenu tools = new JMenu("Tools");
        JMenuItem process = new JMenuItem("Process");
        JMenuItem clear = new JMenuItem("Clear");
        process.addActionListener(e -> processReport());  // Q.2.4
        clear.addActionListener(e -> clearForm());        // Q.2.6
        tools.add(process);
        tools.add(clear);

        bar.add(file);
        bar.add(tools);
        return bar;
    }

    // Q.2.4 capture, validate, calculate (with VAT), display, then save
    private void processReport() {
        try {
            String movie = (String) cmbMovie.getSelectedItem();
            int tickets = Integer.parseInt(txtTickets.getText().trim());
            double price = Double.parseDouble(txtPrice.getText().trim());

            MovieTicketData data = new MovieTicketData(movie, tickets, price);

            if (!logic.ValidateData(data)) {
                JOptionPane.showMessageDialog(this, "Invalid data entered. Check all fields.");
                return;
            }

            double total = logic.CalculateTotalTicketPrice(tickets, price);

            String details = "MOVIE NAME: " + movie + "\n"
                    + "MOVIE TICKET PRICE: R " + price + "\n"
                    + "NUMBER OF TICKETS: " + tickets + "\n"
                    + "TOTAL TICKET PRICE: R " + total;

            txtReport.setText(details);
            saveReport(details);          // Q.2.5 save after the report is generated

        } catch (NumberFormatException ex) {
            JOptionPane.showMessageDialog(this, "Tickets and price must be numbers.");
        }
    }

    // Q.2.5 writes report.txt in the sample format
    private void saveReport(String details) {
        String stars = "*".repeat(36);
        try (PrintWriter out = new PrintWriter(new FileWriter("report.txt"))) {
            out.println("MOVIE TICKET REPORT");
            out.println(stars);
            out.println(details);
            out.println(stars);
        } catch (IOException ex) {
            JOptionPane.showMessageDialog(this, "Could not save file: " + ex.getMessage());
        }
    }

    // Q.2.6 back to the default state
    private void clearForm() {
        cmbMovie.setSelectedIndex(0);
        txtTickets.setText("");
        txtPrice.setText("");
        txtReport.setText("");
    }

    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> new MovieTicketsGUI().setVisible(true));
    }
}

